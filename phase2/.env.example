# Copy to phase2/.env and fill in TEST ACCOUNT credentials only. Never commit .env.
# A server whose variables are missing is skipped, not failed.
# Use read-only scopes wherever the provider allows it.

# Notion: integration token with "Read content" only
NOTION_TOKEN=
# Sentry: user auth token (free account), read scopes
SENTRY_AUTH_TOKEN=
# Microsoft Clarity: Settings > Data Export > generate API token
CLARITY_API_TOKEN=
# Context7: optional. If unset, only healthy + network_down are run.
CONTEXT7_API_KEY=
# Azure DevOps (free organization): org name and a Microsoft Entra BEARER token
# (servers.json uses --authentication envvar, which sends ADO_MCP_AUTH_TOKEN as Bearer, not a PAT), e.g.
#   az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 --query accessToken -o tsv
ADO_ORG=
ADO_MCP_AUTH_TOKEN=
# Microsoft 365 test tenant (NOT a work account): a short-lived Microsoft Graph
# access token with Mail.Read and Calendars.Read, e.g.
#   az account get-access-token --resource https://graph.microsoft.com --query accessToken -o tsv
MS365_MCP_OAUTH_TOKEN=
# Lokka (optional): Entra app registration with app-only User.Read.All
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
